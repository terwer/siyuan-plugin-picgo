{
  "name": "siyuan-plugin-picgo",
  "version": "3.1.2",
  "description": "picgo plugin for siyuan-note",
  "scripts": {
    "clean": "./scripts/clean.sh",
    "serve": "turbo run serve",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "audit:picgo-refactor": "node scripts/picgo-internal-refactor-audit.cjs",
    "cz": "git-cz",
    "makeLink": "python scripts/make_dev_link.py",
    "syncVersion": "python scripts/version.py",
    "parseChangelog": "python scripts/parse_changelog.py",
    "prepareRelease": "pnpm syncVersion && pnpm parseChangelog",
    "package": "python scripts/package.py"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@terwer/commit-config-custom": "^1.2.0",
    "@terwer/eslint-config-custom": "^1.5.0",
    "@typescript/typescript6": "6.0.2",
    "eslint-config-turbo": "^2.1.3",
    "turbo": "^2.1.3"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "zhi-blog-api": "1.83.0",
      "zhi-common": "1.37.0",
      "zhi-device": "2.14.0",
      "zhi-lib-base": "0.10.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
